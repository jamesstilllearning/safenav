  "storage": {
    "buckets": {
      "default": {
        "name": "safenav-cavite.appspot.com",
        "location": "US-CENTRAL1",
        "storageClass": "STANDARD",
        "publicAccessPrevention": "enforced",
        "versioning": true,
        "labels": {
          "purpose": "default",
          "environment": "production"
        },
        "cors": [
          {
            "origin": ["https://safenav-cavite.web.app", "https://safenav-cavite-staging.web.app"],
            "method": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
            "responseHeader": ["Content-Type", "Authorization", "x-goog-resumable"],
            "maxAgeSeconds": 3600
          }
        ],
        "lifecycleRules": [
          {
            "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
            "condition": { "age": 30, "matchesStorageClass": ["STANDARD"] }
          },
          {
            "action": { "type": "SetStorageClass", "storageClass": "COLDLINE" },
            "condition": { "age": 90, "matchesStorageClass": ["NEARLINE"] }
          },
          {
            "action": { "type": "SetStorageClass", "storageClass": "ARCHIVE" },
            "condition": { "age": 365, "matchesStorageClass": ["COLDLINE"] }
          }
        ]
      },
      "uploads": {
        "name": "safenav-cavite-uploads",
        "location": "US-CENTRAL1",
        "storageClass": "STANDARD",
        "publicAccessPrevention": "enforced",
        "versioning": true,
        "labels": { "purpose": "uploads" },
        "cors": [
          {
            "origin": ["https://safenav-cavite.web.app", "http://localhost:3000"],
            "method": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
            "responseHeader": ["Content-Type", "Authorization"],
            "maxAgeSeconds": 3600
          }
        ],
        "lifecycleRules": [
          {
            "action": { "type": "Delete" },
            "condition": { "age": 7, "matchesStorageClass": ["STANDARD"] }
          }
        ]
      },
      "exports": {
        "name": "safenav-cavite-exports",
        "location": "US-CENTRAL1",
        "storageClass": "STANDARD",
        "publicAccessPrevention": "enforced",
        "versioning": true,
        "labels": { "purpose": "exports" },
        "cors": [],
        "lifecycleRules": [
          {
            "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
            "condition": { "age": 30 }
          },
          {
            "action": { "type": "Delete" },
            "condition": { "age": 365 }
          }
        ]
      },
      "backups": {
        "name": "safenav-cavite-backups",
        "location": "US-CENTRAL1",
        "storageClass": "NEARLINE",
        "publicAccessPrevention": "enforced",
        "versioning": true,
        "labels": { "purpose": "backups" },
        "cors": [],
        "lifecycleRules": [
          {
            "action": { "type": "SetStorageClass", "storageClass": "COLDLINE" },
