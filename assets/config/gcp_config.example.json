      {
        "title": "SAFENAV Security",
        "description": "Custom role for SAFENAV security personnel",
        "stage": "GA",
        "includedPermissions": [
          "datastore.documents.list",
          "datastore.documents.get",
          "datastore.documents.create",
          "datastore.documents.update",
          "storage.objects.list",
          "storage.objects.get",
          "cloudfunctions.functions.invoke",
          "run.services.invoke",
          "monitoring.alertPolicies.get",
          "monitoring.alertPolicies.list",
          "logging.logEntries.list"
        ]
      }
    ],
    "bindings": [
      {
        "role": "projects/safenav-cavite/roles/safenavAdmin",
        "members": [
          "user:admin@earist.edu.ph",
          "serviceAccount:firebase-admin@safenav-cavite.iam.gserviceaccount.com"
        ],
        "condition": null
      },
      {
        "role": "projects/safenav-cavite/roles/safenavSecurity",
        "members": [
          "group:security@earist.edu.ph",
          "serviceAccount:api-gateway@safenav-cavite.iam.gserviceaccount.com"
        ],
        "condition": null
      },
      {
        "role": "roles/datastore.viewer",
