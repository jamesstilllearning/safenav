          "serviceAccount:tile-server@safenav-cavite.iam.gserviceaccount.com"
        ],
        "condition": {
          "title": "Tile server read access",
          "description": "Tile server can only read building and pathway data",
          "expression": "resource.name.startsWith('projects/safenav-cavite/databases/(default)/documents/buildings/') || resource.name.startsWith('projects/safenav-cavite/databases/(default)/documents/pathways/')"
        }
      },
      {
        "role": "roles/storage.objectViewer",
        "members": [
          "allUsers"
        ],
        "condition": {
          "title": "Public tile access",
          "description": "Public read access to map tiles bucket",
          "expression": "resource.name.startsWith('projects/_/buckets/safenav-cavite-tiles/objects/')"
        }
      }
    ],
    "serviceAccounts": [
      {
        "accountId": "firebase-admin",
        "displayName": "Firebase Admin SDK",
        "description": "Service account for Firebase Admin SDK operations",
        "roles": [
          "roles/datastore.user",
          "roles/storage.admin",
          "roles/firebaseauth.admin",
          "roles/cloudmessaging.admin"
        ],
        "disabled": false
      },
      {
        "accountId": "api-gateway",
        "displayName": "API Gateway",
        "description": "Service account for Cloud Run API Gateway",
        "roles": [
          "roles/datastore.user",
          "roles/storage.objectViewer",
          "roles/cloudfunctions.invoker"
        ],
        "disabled": false
      },
      {
        "accountId": "tile-server",
        "displayName": "Tile Server",
        "description": "Service account for map tile server",
        "roles": [
          "roles/datastore.viewer",
          "roles/storage.objectViewer"
        ],
        "disabled": false
      },
      {
        "accountId": "cloudrun-default",
        "displayName": "Cloud Run Default",
        "description": "Default service account for Cloud Run services",
        "roles": [],
        "disabled": false
      }
    ]
  },
  "networking": {
    "vpcName": "safenav-vpc",
    "subnets": [
      {
        "name": "safenav-subnet",
        "region": "us-central1",
        "ipCidrRange": "10.0.0.0/24",
        "purpose": "PRIVATE",
        "privateIpGoogleAccess": true
      }
    ],
    "firewallRules": [
      {
        "name": "allow-internal-https",
        "description": "Allow internal HTTPS traffic",
        "direction": "INGRESS",
        "action": "ALLOW",
        "priority": 1000,
        "sourceRanges": ["10.0.0.0/24"],
        "destinationRanges": [],
        "allowed": [
          { "IPProtocol": "tcp", "ports": ["443", "8443"] }
        ],
        "denied": [],
        "targetTags": ["safenav-internal"],
        "sourceTags": []
      },
      {
        "name": "allow-health-checks",
        "description": "Allow GCP health checks",
        "direction": "INGRESS",
        "action": "ALLOW",
        "priority": 1000,
        "sourceRanges": ["130.211.0.0/22", "35.191.0.0/16"],
        "destinationRanges": [],
        "allowed": [
          { "IPProtocol": "tcp", "ports": ["8080", "8081", "8082"] }
        ],
        "denied": [],
        "targetTags": ["safenav-health-check"],
        "sourceTags": []
      },
      {
        "name": "deny-all-ingress",
        "description": "Deny all other ingress traffic",
        "direction": "INGRESS",
        "action": "DENY",
        "priority": 65534,
        "sourceRanges": ["0.0.0.0/0"],
        "destinationRanges": [],
        "allowed": [],
        "denied": [
          { "IPProtocol": "all" }
        ],
        "targetTags": ["safenav-internal"],
        "sourceTags": []
      }
    ],
    "cloudNat": {
      "enabled": true,
      "region": "us-central1"
    }
  },
  "secrets": {
    "enabled": true,
    "secrets": [
      {
        "secretId": "firebase-api-key",
        "description": "Firebase Web API Key",
        "replication": {
          "type": "AUTOMATIC"
        },
        "labels": { "service": "firebase", "environment": "production" },
        "annotations": { "rotation": "manual" },
        "ttl": null,
        "rotationPeriod": "7776000s",
        "nextRotationTime": "2026-02-15T00:00:00Z"
      },
      {
        "secretId": "fcm-server-key",
        "description": "FCM Server Key for push notifications",
        "replication": {
