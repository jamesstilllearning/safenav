  "firestore": {
    "databaseId": "(default)",
    "location": "nam5",
    "indexes": [
      {
        "collectionGroup": "buildings",
        "fields": [
          { "fieldPath": "category", "order": "ASCENDING" },
          { "fieldPath": "name", "order": "ASCENDING" }
        ],
        "queryScope": "COLLECTION"
      },
      {
        "collectionGroup": "pathways",
        "fields": [
          { "fieldPath": "type", "order": "ASCENDING" },
          { "fieldPath": "accessible", "order": "ASCENDING" }
        ],
        "queryScope": "COLLECTION"
      },
      {
        "collectionGroup": "alerts",
        "fields": [
          { "fieldPath": "severity", "order": "DESCENDING" },
          { "fieldPath": "createdAt", "order": "DESCENDING" }
        ],
        "queryScope": "COLLECTION_GROUP"
      },
      {
        "collectionGroup": "evacuationRoutes",
        "fields": [
          { "fieldPath": "buildingId", "order": "ASCENDING" },
          { "fieldPath": "exitId", "order": "ASCENDING" }
        ],
        "queryScope": "COLLECTION"
      },
      {
        "collectionGroup": "userLocations",
        "fields": [
          { "fieldPath": "userId", "order": "ASCENDING" },
          { "fieldPath": "timestamp", "order": "DESCENDING" }
        ],
        "queryScope": "COLLECTION_GROUP"
      }
    ],
    "rules": "firestore.rules",
    "ttlPolicies": [
      {
        "collectionGroup": "sosAlerts",
        "fieldPath": "expiresAt",
        "description": "Auto-delete SOS alerts after expiration"
      },
      {
        "collectionGroup": "locationHistory",
        "fieldPath": "expiresAt",
        "description": "Auto-delete location history after 30 days"
      },
      {
        "collectionGroup": "fcmTokens",
        "fieldPath": "expiresAt",
        "description": "Auto-delete stale FCM tokens"
      }
    ],
    "settings": {
      "ignoreUndefinedProperties": false,
      "localCacheSizeBytes": 41943040
    }
  },
  "functions": {
    "region": "us-central1",
    "runtime": "nodejs20",
    "functions": {
      "sendSosAlert": {
        "name": "sendSosAlert",
        "description": "Send SOS alert to security via FCM and email",
        "entryPoint": "sendSosAlert",
        "trigger": {
          "type": "firestore",
          "eventType": "providers/cloud.firestore/eventTypes/document.create",
          "resource": "projects/safenav-cavite/databases/(default)/documents/sosAlerts/{alertId}"
        },
        "memoryMb": 256,
        "timeoutSeconds": 60,
        "minInstances": 0,
        "maxInstances": 10,
        "environmentVariables": {
          "ALERT_EMAIL": "security@earist.edu.ph",
          "FCM_TOPIC": "security-alerts"
        },
        "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
        "ingressSettings": "ALLOW_INTERNAL_ONLY"
      },
      "cleanupExpiredAlerts": {
        "name": "cleanupExpiredAlerts",
        "description": "Daily cleanup of expired SOS alerts",
        "entryPoint": "cleanupExpiredAlerts",
        "trigger": {
          "type": "schedule",
          "schedule": "0 2 * * *",
          "timeZone": "Asia/Manila"
        },
        "memoryMb": 256,
        "timeoutSeconds": 300,
        "minInstances": 0,
        "maxInstances": 1,
        "environmentVariables": {},
        "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
        "ingressSettings": "ALLOW_INTERNAL_ONLY"
      },
      "dailyAnalytics": {
        "name": "dailyAnalytics",
        "description": "Generate daily analytics reports",
        "entryPoint": "dailyAnalytics",
        "trigger": {
          "type": "schedule",
          "schedule": "0 3 * * *",
          "timeZone": "Asia/Manila"
        },
        "memoryMb": 512,
        "timeoutSeconds": 600,
        "minInstances": 0,
        "maxInstances": 1,
        "environmentVariables": {
          "BIGQUERY_DATASET": "safenav_analytics"
        },
        "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
        "ingressSettings": "ALLOW_INTERNAL_ONLY"
      },
      "registerFcmToken": {
        "name": "registerFcmToken",
        "description": "Register FCM token for push notifications",
        "entryPoint": "registerFcmToken",
        "trigger": {
          "type": "https"
        },
        "memoryMb": 128,
        "timeoutSeconds": 30,
        "minInstances": 0,
        "maxInstances": 100,
        "environmentVariables": {},
        "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
        "ingressSettings": "ALLOW_ALL"
      },
      "importCampusData": {
        "name": "importCampusData",
        "description": "Import campus GeoJSON data to Firestore",
        "entryPoint": "importCampusData",
        "trigger": {
          "type": "https"
        },
        "memoryMb": 512,
        "timeoutSeconds": 600,
        "minInstances": 0,
        "maxInstances": 5,
        "environmentVariables": {
          "GEOJSON_BUCKET": "safenav-cavite-exports"
        },
        "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
        "ingressSettings": "ALLOW_INTERNAL_ONLY"
      }
    },
    "serviceAccount": "firebase-admin@safenav-cavite.iam.gserviceaccount.com",
    "vpcConnector": null,
    "minInstances": 0,
    "maxInstances": 100,
    "timeoutSeconds": 60,
    "memoryMb": 256,
    "environmentVariables": {
      "FIREBASE_PROJECT_ID": "safenav-cavite",
      "ENVIRONMENT": "production"
    },
    "ingressSettings": "ALLOW_INTERNAL_ONLY"
  },
  "monitoring": {
    "enabled": true,
    "logBucket": "safenav-cavite-logs",
    "metrics": [
      {
        "name": "sos_alert_count",
        "type": "CUMULATIVE",
        "description": "Total number of SOS alerts triggered",
        "labels": ["severity", "building"],
        "unit": "1"
      },
      {
        "name": "active_navigation_sessions",
        "type": "GAUGE",
        "description": "Currently active navigation sessions",
        "labels": ["user_role"],
        "unit": "1"
      },
      {
        "name": "api_request_latency",
        "type": "GAUGE",
        "description": "API request latency in milliseconds",
        "labels": ["endpoint", "method"],
        "unit": "ms"
      },
      {
        "name": "firestore_read_operations",
        "type": "CUMULATIVE",
        "description": "Firestore read operations count",
        "labels": ["collection", "operation"],
        "unit": "1"
      },
      {
        "name": "fcm_notification_sent",
        "type": "CUMULATIVE",
        "description": "FCM notifications sent count",
        "labels": ["topic", "status"],
        "unit": "1"
      },
      {
        "name": "map_tile_cache_hit_rate",
        "type": "GAUGE",
        "description": "Map tile cache hit rate percentage",
        "labels": ["zoom_level"],
        "unit": "%"
      }
    ],
    "alerting": {
      "enabled": true,
      "notificationChannels": [
        {
          "type": "email",
          "displayName": "Security Team Email",
          "description": "Email notifications to security team",
          "labels": { "email_address": "security@earist.edu.ph" }
        },
        {
          "type": "email",
          "displayName": "Admin Team Email",
          "description": "Email notifications to admin team",
          "labels": { "email_address": "admin@earist.edu.ph" }
        },
        {
          "type": "webhook",
          "displayName": "Slack Webhook",
          "description": "Send alerts to Slack channel",
          "labels": { "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL_HERE" }
        }
      ],
      "policies": [
        {
          "displayName": "High SOS Alert Rate",
          "description": "Alert when SOS alerts exceed threshold",
          "conditions": [
            {
              "displayName": "SOS alerts per minute > 10",
              "conditionThreshold": {
                "filter": "metric.type=\"custom.googleapis.com/sos_alert_count\"",
                "comparison": "COMPARISON_GT",
                "thresholdValue": 10,
                "duration": "60s",
                "aggregations": [
                  {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": []
                  }
                ]
              }
            }
          ],
          "notificationChannels": ["security-team-email", "slack-webhook"],
          "enabled": true
        },
        {
          "displayName": "High API Latency",
          "description": "Alert when API latency exceeds 5 seconds",
          "conditions": [
            {
              "displayName": "API latency > 5s",
              "conditionThreshold": {
                "filter": "metric.type=\"custom.googleapis.com/api_request_latency\"",
                "comparison": "COMPARISON_GT",
                "thresholdValue": 5000,
                "duration": "300s",
                "aggregations": [
                  {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["endpoint"]
                  }
                ]
              }
            }
          ],
          "notificationChannels": ["admin-team-email"],
          "enabled": true
        },
        {
          "displayName": "Firestore Read Quota Exhaustion",
          "description": "Alert when Firestore reads approach daily quota",
          "conditions": [
            {
              "displayName": "Reads > 40000/min",
              "conditionThreshold": {
                "filter": "metric.type=\"custom.googleapis.com/firestore_read_operations\"",
                "comparison": "COMPARISON_GT",
                "thresholdValue": 40000,
                "duration": "60s",
                "aggregations": [
                  {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": []
                  }
                ]
              }
            }
          ],
          "notificationChannels": ["admin-team-email"],
          "enabled": true
        }
      ]
    },
    "tracing": {
      "enabled": true,
      "samplingRate": 0.1
    }
  },
  "cloudRun": {
    "region": "us-central1",
    "services": {
      "api-gateway": {
        "name": "api-gateway",
        "image": "gcr.io/safenav-cavite/api-gateway:latest",
        "region": "us-central1",
        "memory": "1Gi",
        "cpu": "1",
        "minInstances": 1,
        "maxInstances": 100,
        "concurrency": 80,
        "timeout": "300s",
        "serviceAccount": "api-gateway@safenav-cavite.iam.gserviceaccount.com",
        "vpcConnector": null,
        "ingress": "all",
        "environmentVariables": {
          "FIREBASE_PROJECT_ID": "safenav-cavite",
          "ENVIRONMENT": "production",
          "LOG_LEVEL": "info"
        },
        "labels": {
          "service": "api-gateway",
          "team": "earist-capstone"
        },
        "annotations": {
          "run.googleapis.com/launch-stage": "GA"
        }
      },
      "tile-server": {
        "name": "tile-server",
        "image": "gcr.io/safenav-cavite/tile-server:latest",
        "region": "us-central1",
        "memory": "2Gi",
        "cpu": "2",
        "minInstances": 2,
        "maxInstances": 50,
        "concurrency": 100,
        "timeout": "60s",
        "serviceAccount": "tile-server@safenav-cavite.iam.gserviceaccount.com",
        "vpcConnector": null,
        "ingress": "all",
        "environmentVariables": {
          "TILE_BUCKET": "safenav-cavite-tiles",
          "CACHE_TTL": "86400"
        },
        "labels": {
          "service": "tile-server",
          "team": "earist-capstone"
        },
        "annotations": {}
      }
    },
    "defaultServiceAccount": "cloudrun-default@safenav-cavite.iam.gserviceaccount.com"
  },
  "iam": {
    "roles": [
      {
        "title": "SAFENAV Admin",
